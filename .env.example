# Vendor Management System Environment Configuration

# Ceipal API Configuration
CEIPAL_AUTH_URL=https://api.ceipal.com/v1/createAuthtoken/
CEIPAL_REPORTS_URL=https://bi.ceipal.com/ReportDetails/getReportsData/d2RyRHN0Z0s3R29aNWdyN1h2TnBLUT09
CEIPAL_EMAIL=amir@radixsol.com
CEIPAL_PASSWORD=your_password_here
CEIPAL_API_KEY=2693f0ed28f2250811fe40294e97e108a56afa9043e5336da4

# Legacy ATS API Configuration (optional)
ATS_API_BASE_URL=https://api.ats-provider.com/v1
ATS_API_KEY=your_ats_api_key_here

# Application Settings
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
SESSION_EXPIRE_DAYS=7
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5

# SendGrid Email Configuration
# Used for email OTP sign-in, password resets, and candidate-submission notifications.
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=notifications@radixsol.com
APP_URL=https://your-production-vms-url.example.com

# Optional SMTP fallback for local development when SendGrid is not configured.
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USERNAME=your_outlook_mailbox@yourdomain.com
# SMTP_PASSWORD=your_outlook_smtp_password
# SMTP_FROM_EMAIL=your_outlook_mailbox@yourdomain.com
# SMTP_USE_TLS=true

# Admin submission notification recipients, comma-separated.
SUBMISSION_NOTIFICATION_RECIPIENTS=it.support@radixsol.com

# New-job alert emails. Posted jobs are queued in MongoDB and sent as one digest
# per user every JOB_NOTIFICATION_DIGEST_SECONDS, filtered by each user's
# Job Alerts preferences. Only one API worker sends per cycle.
JOB_POSTING_NOTIFICATIONS_ENABLED=true
JOB_NOTIFICATION_DIGEST_SECONDS=300
JOB_NOTIFICATION_DIGEST_MAX_LISTED=25
JOB_NOTIFICATION_SEND_CONCURRENCY=4

# Job closure emails + in-app notifications, sent immediately (not digested)
# when a tracked job transitions Open/Active -> Closed. Dry-run (audit log
# only, no sends) when unset/false. Circuit breaker: JOB_CLOSURE_PER_RUN_CAP.
JOB_CLOSURE_NOTIFICATIONS_ENABLED=true
JOB_CLOSURE_PER_RUN_CAP=25

# Open/closed job count report. One e-mail to these recipients every
# JOB_STATUS_REPORT_SECONDS (7200 = 2 hours); only one worker sends per interval.
# Admin can trigger one immediately: POST /api/admin/job-status-report/send
JOB_STATUS_REPORT_ENABLED=true
JOB_STATUS_REPORT_SECONDS=7200
JOB_STATUS_REPORT_RECIPIENTS=het@radixsol.com

# Optional: require this token (X-Ingest-Token header) on the unauthenticated
# /api/nexus/jobs routes. Set the same value for the sync process.
# NEXUS_INGEST_TOKEN=
# Sync credentials (otherwise the old built-in defaults are used - rotate them).
# VMS_BASE_URL=
# VMS_ADMIN_EMAIL=
# VMS_ADMIN_PASSWORD=

# Jobs list freshness: a background task in each worker polls a shared version
# stamp this often (seconds) and rebuilds the list off the request path, so a job
# posted via one worker shows on the others within ~5-7 s.
JOBS_VERSION_POLL_SECONDS=5
# The users list is kept in memory per worker and re-read this often (seconds);
# deactivations reach every worker within this interval.
USER_LOOKUP_CACHE_SECONDS=60
SLOW_REQUEST_MS=500

# Safety-net reload interval for the job list (seconds), for changes made
# without going through the API (e.g. edits directly in Atlas).
MANUAL_JOBS_CACHE_SECONDS=300
USERS_CACHE_SECONDS=300
MONGODB_MAX_POOL_SIZE=20
# Connections kept open to MongoDB. Each new one costs several round trips.
MONGODB_MIN_POOL_SIZE=10
# Threads for blocking work (auth lookups, job payloads). The default would be
# CPU count + 4, i.e. 5 on a 1-vCPU instance.
ASYNC_THREAD_POOL_SIZE=32
# Startup warns, and /api/health flags mongodb_slow, above this round trip.
# A few ms means same region; tens of ms means Atlas is in another region.
MONGODB_SLOW_PING_MS=15

# MongoDB Configuration
MONGODB_URI=

# File Upload Settings
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
CEIPAL_CACHE_DIR=./data/cache
MAX_FILE_SIZE=10485760  # 10MB in bytes
ALLOWED_EXTENSIONS=pdf,doc,docx,txt

# Development/Testing
DEBUG=True
TESTING_MODE=False

# The job list is read from MongoDB in chunks of MANUAL_JOBS_BATCH_SIZE jobs,
# MANUAL_JOBS_READ_CONCURRENCY chunks at a time, each retried on its own, so a
# slow batch no longer truncates the list (~100 jobs) or forces a full re-read.
# MONGODB_SOCKET_TIMEOUT_MS=20000
# MANUAL_JOBS_READ_ATTEMPTS=3
# MANUAL_JOBS_BATCH_SIZE=200
# MANUAL_JOBS_READ_CONCURRENCY=4
# Right after startup, /api/jobs waits this long for the first list, then 503s
# (the page retries automatically).
# JOBS_FIRST_LOAD_WAIT_SECONDS=25
