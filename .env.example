# Vendor Management System Environment Configuration

# Ceipal API Configuration
CEIPAL_AUTH_URL=https://api.ceipal.com/v1/createAuthtoken/
CEIPAL_REPORTS_URL=https://bi.ceipal.com/ReportDetails/getReportsData/d2RyRHN0Z0s3R29aNWdyN1h2TnBLUT09
CEIPAL_EMAIL=amir@radixsol.com
CEIPAL_PASSWORD=your_password_here
CEIPAL_API_KEY=2693f0ed28f2250811fe40294e97e108a56afa9043e5336da4

# Legacy ATS API Configuration (optional)
ATS_API_BASE_URL=https://api.ats-provider.com/v1
ATS_API_KEY=your_ats_api_key_here

# Application Settings
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
SESSION_EXPIRE_DAYS=7
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5

# SendGrid Email Configuration
# Used for email OTP sign-in, password resets, and candidate-submission notifications.
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=notifications@radixsol.com
APP_URL=https://your-production-vms-url.example.com

# Optional SMTP fallback for local development when SendGrid is not configured.
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USERNAME=your_outlook_mailbox@yourdomain.com
# SMTP_PASSWORD=your_outlook_smtp_password
# SMTP_FROM_EMAIL=your_outlook_mailbox@yourdomain.com
# SMTP_USE_TLS=true

# Admin submission notification recipients, comma-separated.
SUBMISSION_NOTIFICATION_RECIPIENTS=it.support@radixsol.com

# New-job alert emails. Posted jobs are queued in MongoDB and sent as one digest
# per user every JOB_NOTIFICATION_DIGEST_SECONDS, filtered by each user's
# Job Alerts preferences. Only one API worker sends per cycle.
JOB_POSTING_NOTIFICATIONS_ENABLED=true
JOB_NOTIFICATION_DIGEST_SECONDS=300
JOB_NOTIFICATION_DIGEST_MAX_LISTED=25
JOB_NOTIFICATION_SEND_CONCURRENCY=4

# Per-worker cache lifetimes (seconds). Lower MANUAL_JOBS_CACHE_SECONDS if new
# jobs must appear faster on the workers that did not receive the post.
MANUAL_JOBS_CACHE_SECONDS=300
USERS_CACHE_SECONDS=300
MONGODB_MAX_POOL_SIZE=50
# Startup warns, and /api/health flags mongodb_slow, above this round trip.
# A few ms means same region; tens of ms means Atlas is in another region.
MONGODB_SLOW_PING_MS=15

# MongoDB Configuration
MONGODB_URI=

# File Upload Settings
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
CEIPAL_CACHE_DIR=./data/cache
MAX_FILE_SIZE=10485760  # 10MB in bytes
ALLOWED_EXTENSIONS=pdf,doc,docx,txt

# Development/Testing
DEBUG=True
TESTING_MODE=False
